generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VALIDATOR
}

enum TicketStatus {
  PENDING_PAYMENT
  PAID
  USED
  CANCELLED
}

// Staff users (admins + validators) - added manually to DB
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scans Scan[]
}

// Whitelisted people (public purchasers)
model WhitelistedPerson {
  id              String   @id @default(cuid())
  govIdNumber     String   @unique
  name            String
  email           String
  instagramHandle String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  allowedTicketTypes WhitelistedPersonTicketType[]
  tickets            Ticket[]
}

// Events (parties)
model Event {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  date             DateTime
  location         String?
  locationRevealed Boolean  @default(false)
  coverImageUrl    String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ticketTypes TicketType[]
  tickets     Ticket[]
}

// Ticket types per event
model TicketType {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  price     Int      // Price in cents (0 for free)
  currency  String   @default("UYU")
  capacity   Int?      // null = unlimited
  validUntil DateTime? // Optional: tickets of this type expire after this time
  sortOrder  Int       @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets               Ticket[]
  allowedForWhitelisted WhitelistedPersonTicketType[]

  @@unique([eventId, name])
}

// Join table: which whitelisted person can buy which ticket type
model WhitelistedPersonTicketType {
  id                  String            @id @default(cuid())
  whitelistedPersonId String
  ticketTypeId        String
  whitelistedPerson   WhitelistedPerson @relation(fields: [whitelistedPersonId], references: [id], onDelete: Cascade)
  ticketType          TicketType        @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([whitelistedPersonId, ticketTypeId])
}

// Purchased/issued tickets
model Ticket {
  id                  String             @id @default(cuid())
  eventId             String
  event               Event              @relation(fields: [eventId], references: [id])
  ticketTypeId        String
  ticketType          TicketType         @relation(fields: [ticketTypeId], references: [id])
  whitelistedPersonId String?
  whitelistedPerson   WhitelistedPerson? @relation(fields: [whitelistedPersonId], references: [id])
  freeInviteLinkId    String?
  freeInviteLink      FreeInviteLink?    @relation(fields: [freeInviteLinkId], references: [id])

  qrCodeToken   String?  @unique // UUID v4, set only after payment confirmed
  qrSignedJwt   String?           // Signed JWT for QR payload

  status          TicketStatus @default(PENDING_PAYMENT)
  purchaserName   String
  purchaserEmail  String
  purchaserGovId  String?

  validUntil      DateTime? // Resolved expiration time for scanning

  mpOrderId       String?
  mpPaymentStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans Scan[]
}

// QR scan audit log
model Scan {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  validatorId String
  validator   User     @relation(fields: [validatorId], references: [id])
  scannedAt   DateTime @default(now())
  wasValid    Boolean
}

// Free invite links generated by admins
model FreeInviteLink {
  id           String   @id @default(cuid())
  token        String   @unique @default(cuid())
  eventId      String
  ticketTypeId String
  expiresAt        DateTime
  ticketValidUntil DateTime? // Optional: tickets from this link expire after this time
  maxUses          Int       @default(1)
  usedCount    Int      @default(0)
  createdBy    String
  createdAt    DateTime @default(now())

  tickets Ticket[]
}
