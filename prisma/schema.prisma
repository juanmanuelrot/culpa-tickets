generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VALIDATOR
}

enum TicketStatus {
  PENDING_PAYMENT
  PAID
  USED
  CANCELLED
}

// De dónde salió la entrada: comprada en el sitio, cobrada por fuera
// (transferencia o efectivo) o regalada. Las dos últimas salen de "Generar QR".
enum TicketOrigin {
  ONLINE
  OFFLINE_PAID
  COURTESY
}

// Staff users (admins + validators) - added manually to DB
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scans         Scan[]
  issuedTickets Ticket[]
}

// Events (parties)
model Event {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  date             DateTime
  location         String?
  locationRevealed Boolean  @default(false)
  coverImageUrl    String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ticketTypes   TicketType[]
  tickets       Ticket[]
  cartReminders CartReminder[]
}

// Ticket types per event
model TicketType {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  price     Int      // Price in cents (0 for free)
  currency  String   @default("UYU")
  capacity   Int?      // null = unlimited
  validUntil DateTime? // Optional: tickets of this type expire after this time
  isOffered  Boolean   @default(true) // false = retired from sale (shows as sold out, blocks new purchases)
  sortOrder  Int       @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@unique([eventId, name])
}

// Purchased/issued tickets
model Ticket {
  id                  String             @id @default(cuid())
  eventId             String
  event               Event              @relation(fields: [eventId], references: [id])
  ticketTypeId        String
  ticketType          TicketType         @relation(fields: [ticketTypeId], references: [id])
  promoterId          String?
  promoter            Promoter?          @relation(fields: [promoterId], references: [id])
  discountInCents     Int                @default(0) // lo que se le descontó por el link del RRPP

  origin           TicketOrigin @default(ONLINE)
  chargedInCents   Int?  // solo QR: lo que se cobró por fuera (0 en cortesías)
  faceValueInCents Int?  // solo QR: el precio del tipo de entrada al emitirla
  issuedById       String? // solo QR: el admin que la generó
  issuedBy         User?   @relation(fields: [issuedById], references: [id])

  qrCodeToken   String?  @unique // UUID v4, set only after payment confirmed
  qrSignedJwt   String?           // Signed JWT for QR payload

  status          TicketStatus @default(PENDING_PAYMENT)
  purchaserName   String
  purchaserEmail  String?      // null for admin-issued QR invites with no email
  purchaserGovId  String?

  validUntil      DateTime? // Resolved expiration time for scanning

  mpOrderId       String?
  mpPaymentStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans Scan[]
}

// QR scan audit log
model Scan {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  validatorId String
  validator   User     @relation(fields: [validatorId], references: [id])
  scannedAt   DateTime @default(now())
  wasValid    Boolean
}

// RRPP: cada uno comparte /event/<slug>?rrpp=<code> y las ventas que entran por ahí quedan a su nombre.
model Promoter {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  // % que se descuenta del precio de la entrada a quien compra por su link.
  // Sirve para campañas (ej. un RRPP "mail" con 10% para los mails de Resend).
  discountPercent Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

// Mails de carrito abandonado: a quien empezó a pagar y no terminó. Uno por
// persona (email en minúsculas), evento y etapa (1 = a la hora, 2 = a las 24h),
// sin importar cuántos intentos haya hecho; el unique lo garantiza.
model CartReminder {
  id      String   @id @default(cuid())
  email   String
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage   Int
  sentAt  DateTime @default(now())

  @@unique([email, eventId, stage])
}

// Configuración global del sitio, clave/valor. Hoy solo guarda `theme`.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
